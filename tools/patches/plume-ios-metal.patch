+    uint32_t getSpirvResourceArrayCount(const spirv_cross::SPIRType& type) {
+        uint32_t count = 1;
+        for (const uint32_t dimension : type.array) {
+            if (dimension == 0) {
+                return count;
+            }
+            count *= dimension;
+        }
+
+        return count;
+    }
